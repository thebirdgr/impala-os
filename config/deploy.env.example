# Copy to config/deploy.env (git-ignored) and adjust.
IMPALA_HOST=impala.local
# IMPALA_USER=pi-user
# IMPALA_SSH_OPTS="-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes"
# IMPALA_REMOTE_DIR=impala-os
# IMPALA_JOBS=2
# Direct Ethernet cable instead of Wi-Fi: the Pi's IPv6 link-local address
# plus the PC's interface index (Get-NetAdapter). HostKeyAlias lets ssh check
# the key already trusted for impala.local.
# IMPALA_HOST=fe80::<pi-address>%<pc-if-index>
# IMPALA_SSH_OPTS="-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes -o HostKeyAlias=impala.local"
